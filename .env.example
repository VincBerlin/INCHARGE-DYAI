# Vercel → Project → Settings → Environment Variables
# Pflicht: wird serverseitig genutzt, niemals als VITE_ Variable anlegen.
IP_HASH_SECRET=replace-with-a-long-random-secret

# Optional, aber empfohlen für dauerhafte Nachweisspeicherung.
# Beispiel: n8n, Make, Supabase Edge Function, eigene API.
CONFIRMATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com
